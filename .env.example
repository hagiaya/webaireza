# ==========================================
# ARA STUDIO - AI INFLUENCER AUTOMATION
# ENV CONFIGURATION
# ==========================================

# 1. SUPABASE DATABASE & STORAGE CONFIG
# Dapatkan URL & Anon Key di: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. AI GENERATION API KEYS
# Dapatkan Claude API Key di: Anthropic Console -> API Keys
ANTHROPIC_API_KEY=your_anthropic_claude_api_key

# 3. OTHER SETTINGS (Optional)
# Dapatkan ElevenLabs API Key jika menggunakan engine voice synthesis eksternal
ELEVENLABS_API_KEY=your_elevenlabs_api_key
